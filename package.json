{
  "name": "ai-clustering",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AIクラスタリング — ブラウザだけで完結する、テーブルデータの自動クラスタリング（顧客セグメンテーション）アプリ",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "e2e": "playwright test",
    "bench": "node --experimental-strip-types --max-old-space-size=4096 scripts/bench.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  },
  "license": "MIT"
}
